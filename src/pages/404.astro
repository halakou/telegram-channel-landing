---
import ChannelLayout from '../layouts/ChannelLayout.astro';

const demoUrl = 'https://t.me/nova_digest_demo';
// Minimal mock channel object for layout/head tags only
const demoChannel = {
  slug: 'demo-channel',
  seo: {
    title: 'Page Not Found — Nova Digest',
    description: 'The page you are looking for does not exist.',
  },
  theme: { accent: '#6C63FF', accentRgb: '108, 99, 255' },
} as const;
---
<ChannelLayout channel={demoChannel}>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="text-align: center; max-width: 480px; margin: 0 auto;">
      <h1 style="font-size: 6rem; font-weight: 800; color: var(--text-muted); line-height: 1;">404</h1>
      <p style="font-size: 1.25rem; color: var(--text-secondary); margin-top: 1.5rem;">The page you're looking for doesn't exist.</p>
      <p style="color: var(--text-muted); margin-top: 0.5rem;">It may have been moved or removed.</p>
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 2rem; padding: 0.875rem 1.75rem; background: #6C63FF; color: white; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 1rem; transition: opacity 0.2s;"
        onmouseenter={e => { e.currentTarget.style.opacity = '0.85'; }}
        onmouseleave={e => { e.currentTarget.style.opacity = '1'; }}
      >
        <span>←</span>
        <span>Visit Demo Channel</span>
      </a>
    </div>
  </div>
</ChannelLayout>
