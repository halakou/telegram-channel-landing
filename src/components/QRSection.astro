---
const { url } = Astro.props;
---
<section aria-label="QR Code" style="max-width: 640px; margin: 0 auto; padding: 2rem 1.5rem 3rem; text-align: center;">
  <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Join with your phone</h2>
  <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 2rem;">Scan the QR code to open Telegram on your device</p>
  <div style="display: inline-block; background: white; padding: 1rem; border-radius: 16px; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);">
    <canvas id="qr-canvas" aria-label={`QR code for ${url}`} role="img"></canvas>
  </div>
</section>

<script define:vars={{ url }}>
  import QRCode from 'qrcode';
  QRCode.toCanvas(document.getElementById('qr-canvas'), url, {
    width: 200,
    margin: 2,
    color: { dark: '#0a0a0f', light: '#ffffff' },
  });
</script>
