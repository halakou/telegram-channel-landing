---
const { stats } = Astro.props;
---
<section aria-label="Statistics" style="max-width: 640px; margin: 0 auto; padding: 0 1.5rem 3rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem;">
    <!-- Members -->
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; text-align: center; transition: transform 0.2s, border-color 0.2s;" onmouseenter={e => { e.currentTarget.style.transform = 'translateY(-2px)'; }} onmouseleave={e => { e.currentTarget.style.transform = 'translateY(0)'; }}>
      <div style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">{stats.membersLabel}</div>
      <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Members</div>
    </div>
    <!-- Posts -->
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; text-align: center; transition: transform 0.2s, border-color 0.2s;" onmouseenter={e => { e.currentTarget.style.transform = 'translateY(-2px)'; }} onmouseleave={e => { e.currentTarget.style.transform = 'translateY(0)'; }}>
      <div style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary);">{stats.postsPerDay}</div>
      <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Frequency</div>
    </div>
    <!-- Public -->
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; text-align: center; transition: transform 0.2s, border-color 0.2s;" onmouseenter={e => { e.currentTarget.style.transform = 'translateY(-2px)'; }} onmouseleave={e => { e.currentTarget.style.transform = 'translateY(0)'; }}>
      <div style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">{stats.isPublic ? 'Public' : 'Private'}</div>
      <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Type</div>
    </div>
    <!-- Active -->
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; text-align: center; transition: transform 0.2s, border-color 0.2s;" onmouseenter={e => { e.currentTarget.style.transform = 'translateY(-2px)'; }} onmouseleave={e => { e.currentTarget.style.transform = 'translateY(0)'; }}>
      <div style="font-size: 1rem; font-weight: 600; color: #4ade80;">Active</div>
      <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Status</div>
    </div>
  </div>
</section>
