---
const { post } = Astro.props;
const viewsFormatted = post.views >= 1000 ? `${(post.views / 1000).toFixed(1)}K` : String(post.views);
---
<section aria-label="Featured post" style="max-width: 640px; margin: 0 auto; padding: 2rem 1.5rem 3rem;">
  <h2 style="font-size: 1.5rem; font-weight: 700; text-align: center; margin-bottom: 2rem;">Featured post</h2>
  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; position: relative; overflow: hidden;">
    <div class="featured-glow" style="position: absolute; top: -40%; right: -20%; width: 50%; height: 80%; background: radial-gradient(circle, rgba(var(--accent-rgb), 0.1) 0%, transparent 70%); pointer-events: none;" />
    <div style="position: relative; z-index: 1;">
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; line-height: 1.4;">{post.title}</h3>
      <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem;">{post.body}</p>
      <div style="display: flex; gap: 1.5rem; color: var(--text-muted); font-size: 0.85rem;">
        <span>{post.date}</span>
        <span>👁 {viewsFormatted} views</span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .featured-glow { display: none !important; }
  }
</style>
